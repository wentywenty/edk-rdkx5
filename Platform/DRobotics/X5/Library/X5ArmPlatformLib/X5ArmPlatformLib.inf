## @file
#  ArmPlatformLib implementation for the RDK X5 (Sunrise X5) SoC.
#
#  Provides a coarse, executable DRAM identity map for the SEC phase because
#  the EDK2 image is loaded as the BL33 payload at 0x8800_0000 in DRAM (the
#  generic ArmPlatformLibNull/PL011-PL031 helpers do not map that region).
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 1.27
  BASE_NAME                      = X5ArmPlatformLib
  FILE_GUID                      = a1c4e7b2-58d3-4f60-9e21-7b0c9a5d3e84
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ArmPlatformLib

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  ArmPlatformPkg/ArmPlatformPkg.dec
  Platform/DRobotics/X5/X5Pkg.dec

[LibraryClasses]
  ArmLib
  DebugLib

[Sources.common]
  X5ArmPlatformLib.c
  X5IdMap.S
  X5ArmPlatformHelper.S

[FixedPcd]
  gArmTokenSpaceGuid.PcdArmPrimaryCoreMask
  gArmTokenSpaceGuid.PcdArmPrimaryCore
